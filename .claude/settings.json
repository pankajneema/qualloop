{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --amend:*)",
      "Bash(git filter-branch:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
