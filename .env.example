# QualLoop — example environment (docs/architecture/REPO_LAYOUT.md §5).
# Placeholder values only. Copy to .env for local overrides; .env is gitignored.
# Values outside QL_ENV=local must come from the secrets manager (ADR-019); the API refuses
# to start outside local with these defaults.

# Required, no default: local | ci | staging | prod.
QL_ENV=local

# Postgres (app role is RLS-bound; owner role runs migrations)
QL_DATABASE_URL=postgresql+psycopg://qualloop_app:qualloop_app@postgres:5432/qualloop
# Migration job ONLY (alembic); never given to api/worker/dispatcher/scheduler.
QL_DATABASE_URL_OWNER=postgresql+psycopg://qualloop_owner:qualloop_owner@postgres:5432/qualloop
QL_TEST_DATABASE_URL=postgresql+psycopg://qualloop_app:qualloop_app@postgres:5432/qualloop_test
QL_TEST_DATABASE_URL_OWNER=postgresql+psycopg://qualloop_owner:qualloop_owner@postgres:5432/qualloop_test

# Redis: AUTH is required; the app connects as ACL user qualloop_app (default user disabled, INV-SEC-08).
# infra/redis/users.acl.tmpl is rendered with QL_REDIS_PASSWORD at start. Placeholder only; the URL password must match.
QL_REDIS_PASSWORD=qualloop-redis-dev-only
QL_REDIS_URL=redis://qualloop_app:qualloop-redis-dev-only@redis:6379/0
# Worker process only (A-122): ACL user qualloop_worker may run KEYS (Dramatiq dead-worker maintenance). Own password.
QL_REDIS_WORKER_PASSWORD=qualloop-redis-worker-dev-only
QL_REDIS_WORKER_URL=redis://qualloop_worker:qualloop-redis-worker-dev-only@redis:6379/0

# Object storage (S3-compatible; local dev image)
QL_S3_ENDPOINT_URL=http://s3:8333
QL_S3_BUCKET_FILES=qualloop-files
QL_S3_BUCKET_QUARANTINE=qualloop-quarantine
QL_S3_ACCESS_KEY=qualloop-dev
QL_S3_SECRET_KEY=change-me-local-only
QL_S3_REGION=us-east-1
# Host used to sign presigned URLs for the browser (compose-internal host `s3` is not reachable from it).
QL_S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# Email (local: mailpit)
QL_SMTP_HOST=mailpit
QL_SMTP_PORT=1025
QL_MAIL_FROM=QualLoop <no-reply@qualloop.in>

# Virus scanning (ClamAV clamd, ADR-011 / A-47). Host-side tests use localhost; compose services use clamav.
QL_CLAMAV_HOST=clamav
QL_CLAMAV_PORT=3310

# Secrets (min 32 characters outside local)
QL_SESSION_SECRET=change-me-32-bytes-min
QL_HMAC_SECRET=change-me-32-bytes-min

# Links in messages
QL_PUBLIC_BASE_URL=http://localhost:3000

# Providers (fake = local stand-ins; no paid services in dev)
QL_WHATSAPP_PROVIDER=fake
QL_AI_PROVIDER=fake

# Observability
QL_LOG_LEVEL=INFO
QL_OTEL_EXPORTER_OTLP_ENDPOINT=

# Web
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Trusted reverse proxies (CIDR list). The client IP is the right-most untrusted X-Forwarded-For entry, used only
# when the socket peer is in this list (A-106). Compose pins its network to 172.29.0.0/24 (the web container proxies
# the api). Production gets the load-balancer subnets in P09. Empty = never trust X-Forwarded-For.
QL_TRUSTED_PROXIES=172.29.0.0/24

# Local host ports for docker compose (change if 5432 / 6379 are taken on your machine)
QL_PG_HOST_PORT=5432
QL_REDIS_HOST_PORT=6379

# Browser uploads (A-120): the single web origin the quarantine bucket's CORS allows (PUT only, no wildcard).
# Must match where the browser loads the app. Staging/prod CORS is set in IaC (P09).
QL_WEB_ORIGIN=http://localhost:3000
