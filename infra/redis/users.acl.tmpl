# Redis ACL template (INV-SEC-08, ADR-008 D-5, ADR-019). DEV/CI ONLY: entrypoint.sh renders this into a real ACL file,
# replacing @APP_HASH@ with sha256(QL_REDIS_PASSWORD). Staging/prod use managed Redis RBAC from IaC with
# secrets-manager credentials.
#
# default user is disabled: no connection without AUTH, and "default" cannot authenticate at all.
user default off nopass resetkeys -@all
#
# qualloop_app: only the key families of ADR-008, everything except admin/dangerous categories and the commands
# that are not in those categories but are unsafe on a shared instance.
#   - dramatiq:*  Dramatiq broker keys (queues, .DQ delay queues, .XQ dead letters, acks, heartbeats)
#   - ~dramatiq (exact key, beyond ADR-008): Dramatiq's Lua dispatch script is called with KEYS[1] = the bare namespace
#     "dramatiq" and the ACL key-checks declared keys; without it every enqueue fails with NOPERM. It holds no data.
#   - scripting (EVALSHA/SCRIPT LOAD) stays allowed because Dramatiq's broker runs Lua; scripts are still
#     key-checked by the ACL, so a script cannot touch keys outside the patterns above.
user qualloop_app on #@APP_HASH@ resetkeys ~sess:* ~user_sessions:* ~otp:* ~rl:* ~idem:* ~sched:* ~dramatiq:* ~dramatiq resetchannels +@all -@admin -@dangerous -flushall -flushdb -keys -config
